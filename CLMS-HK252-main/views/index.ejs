        function isValidCoordinate(lat, lng) {
            return Number.isFinite(Number(lat)) && Number.isFinite(Number(lng));
        }

        function getPolygonPoints(safeZone) {
            if (!safeZone || !Array.isArray(safeZone.polygonPoints)) return [];

            return safeZone.polygonPoints
                .map(p => ({ lat: Number(p.lat), lng: Number(p.lng) }))
                .filter(p => isValidCoordinate(p.lat, p.lng));
        }

        function getSafeZoneCenter(safeZone) {
            if (!safeZone) return DEFAULT_MAP_CENTER;

            if (safeZone.type === 'polygon') {
                const points = getPolygonPoints(safeZone).map(p => [p.lat, p.lng]);
                if (points.length >= 3) {
                    const center = L.latLngBounds(points).getCenter();
                    return [center.lat, center.lng];
                }
            }

            if (isValidCoordinate(safeZone.lat, safeZone.lng)) {
                return [Number(safeZone.lat), Number(safeZone.lng)];
            }

            return DEFAULT_MAP_CENTER;
        }

        function createSafeZoneLayer(safeZone) {
            if (!safeZone) return null;

